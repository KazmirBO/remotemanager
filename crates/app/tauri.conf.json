{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Menedżer sesji",
  "version": "0.1.0",
  "identifier": "dev.multiremotemanager.client",
  "build": {
    "beforeDevCommand": "pnpm --dir ../../app/ui dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../app/ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Menedżer sesji",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "decorations": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "license": "MIT OR Apache-2.0",
    "externalBin": [
      "binaries/multiremotemanager-rdp-worker"
    ],
    "shortDescription": "Klient SSH i RDP z drzewem hostów",
    "category": "Utility",
    "linux": {
      "deb": {
        "desktopTemplate": "../../packaging/desktop.hbs"
      },
      "rpm": {
        "desktopTemplate": "../../packaging/desktop.hbs"
      }
    }
  }
}
